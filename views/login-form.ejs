<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Enter Whisperwell</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="min-h-screen bg-cream font-sans text-ink">
  <header class="border-b-2 border-ink/10 bg-cream/95">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5 lg:px-8">
      <a href="/" class="flex items-center gap-3" aria-label="Whisperwell home">
        <span class="grid h-10 w-10 rotate-3 place-items-center rounded-xl bg-ink text-xl text-mint shadow-[4px_4px_0_#ff6b5f]">✦</span>
        <span class="text-xl font-black tracking-tight">Whisperwell</span>
      </a>
      <a href="/sign-up" class="rounded-full border-2 border-ink px-4 py-2 text-sm font-bold transition hover:bg-ink hover:text-white">Create an account</a>
    </nav>
  </header>

  <main class="mx-auto grid max-w-6xl gap-12 px-5 py-12 lg:grid-cols-[1fr_0.9fr] lg:px-8 lg:py-20">
    <section class="relative self-center">
      <p class="mb-5 inline-flex rounded-full bg-lilac px-4 py-2 text-xs font-black uppercase tracking-[0.2em]">Welcome back</p>
      <h1 class="font-display text-5xl leading-tight sm:text-6xl">The well kept your <span class="text-coral">seat.</span></h1>
      <p class="mt-6 max-w-md text-lg leading-8 text-ink/70">Step back into the clubhouse, catch up on the latest whispers, and add a thought of your own.</p>
      <div class="relative mt-8 flex min-h-44 max-w-md items-end justify-center overflow-hidden rounded-3xl border-2 border-ink/10 bg-mint/60 p-4 shadow-[7px_7px_0_#e6ddff]">
        <div class="absolute -left-8 -top-10 h-28 w-28 rounded-full bg-lilac/80"></div>
        <div class="absolute -bottom-12 -right-5 h-32 w-32 rounded-full bg-coral/25"></div>
        <img src="/images/whisperwell-owl-smile.png" alt="A smiling owl waving hello" class="relative z-10 h-44 w-44 object-contain drop-shadow-[4px_5px_0_rgba(32,36,58,0.15)] transition duration-500 ease-out animate-bounce hover:rotate-6 hover:scale-110">
        <span class="absolute right-6 top-5 z-20 rounded-2xl border-2 border-ink bg-white px-3 py-2 text-sm font-black shadow-[3px_3px_0_#20243a]">Good to see you!</span>
      </div>
    </section>

    <section class="rounded-3xl border-2 border-ink/10 bg-white p-6 shadow-[8px_8px_0_#c9f5df] sm:p-9">
      <div class="mb-8">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-coral">Member access</p>
        <h2 class="mt-2 font-display text-4xl">Enter the well</h2>
      </div>

      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="mb-6 rounded-2xl border-2 border-coral/40 bg-coral/10 p-4 text-sm" role="alert" aria-live="polite"><%= errorMessage %></div>
      <% } %>

      <form action="/log-in" method="POST" class="space-y-5">
        <div>
          <label for="email" class="mb-2 block text-sm font-bold">Email address</label>
          <input id="email" name="email" type="email" autocomplete="email" required value="<%= typeof email !== 'undefined' ? email : '' %>" class="w-full rounded-xl border-2 border-ink/15 bg-cream px-4 py-3 outline-none transition placeholder:text-ink/35 focus:border-coral focus:ring-4 focus:ring-coral/10" placeholder="you@example.com">
        </div>
        <div>
          <label for="password" class="mb-2 block text-sm font-bold">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required class="w-full rounded-xl border-2 border-ink/15 bg-cream px-4 py-3 outline-none transition placeholder:text-ink/35 focus:border-coral focus:ring-4 focus:ring-coral/10" placeholder="Your password">
        </div>
        <button type="submit" class="w-full rounded-xl bg-ink px-5 py-3.5 font-bold text-white shadow-[4px_4px_0_#ff6b5f] transition hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none">Enter the clubhouse <span class="ml-1">↗</span></button>
      </form>
    </section>
  </main>
</body>
</html>
