<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Whisperwell | Anonymous stories</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="min-h-screen bg-cream font-sans text-ink">
  <header class="border-b-2 border-ink/10 bg-cream/95">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5 lg:px-8">
      <a href="/" class="group flex items-center gap-3" aria-label="Whisperwell home">
        <span class="grid h-10 w-10 rotate-3 place-items-center rounded-xl bg-ink text-xl text-mint shadow-[4px_4px_0_#ff6b5f]">✦</span>
        <span class="text-xl font-black tracking-tight">Whisperwell</span>
      </a>
      <div class="flex items-center gap-3 text-sm font-bold">
        <% if (currentUser) { %>
          <span class="hidden text-ink/60 sm:inline">Welcome back, <%= currentUser.first_name %></span>
          <a href="/log-out" class="rounded-full border-2 border-ink px-4 py-2 transition hover:bg-ink hover:text-white">Sign out</a>
        <% } else { %>
          <a href="/log-in" class="rounded-full px-4 py-2 transition hover:bg-lilac">Enter</a>
          <a href="/sign-up" class="rounded-full bg-coral px-4 py-2 text-white shadow-[3px_3px_0_#20243a] transition hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-none">Make an account</a>
        <% } %>
      </div>
    </nav>
  </header>

  <main class="mx-auto max-w-6xl px-5 pb-20 pt-12 lg:px-8 lg:pt-20">
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
      <div class="mb-8 flex items-center gap-4 rounded-2xl border-2 border-emerald-700/30 bg-emerald-200 px-6 py-5 text-lg font-bold text-emerald-950 shadow-[5px_5px_0_#86efac]" role="status" aria-live="polite">
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-emerald-600 text-xl font-black text-white">✓</span>
        <span><%= successMessage %></span>
      </div>
    <% } %>
    <section class="grid items-end gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <% if (currentUser) { %>
          <p class="mb-5 inline-flex rounded-full bg-coral px-4 py-2 text-xs font-black uppercase tracking-[0.2em] text-white">The well is listening</p>
          <h1 class="max-w-3xl font-display text-6xl leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl">Howdy, <span class="text-coral"><%= currentUser.first_name %>.</span><br>Leave a little <span class="text-coral">whisper.</span></h1>
          <p class="mt-7 max-w-xl text-lg leading-8 text-ink/70">You’re inside the clubhouse. Put a thought into words and let the community discover it.</p>
        <% } else { %>
          <p class="mb-5 inline-flex rounded-full bg-mint px-4 py-2 text-xs font-black uppercase tracking-[0.2em]">A little room for big thoughts</p>
          <h1 class="max-w-3xl font-display text-6xl leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl">Say it.<br><span class="text-coral">Leave no trace.</span></h1>
          <p class="mt-7 max-w-xl text-lg leading-8 text-ink/70">Whisperwell is a quiet corner for honest stories and curious minds. Everyone can read the words; members get to know the voices behind them.</p>
        <% } %>
        <% if (currentUser) { %>
          <a href="/new-message" class="mt-8 inline-flex items-center rounded-2xl bg-coral px-7 py-4 text-lg font-black text-white shadow-[6px_6px_0_#20243a] transition hover:translate-x-1 hover:translate-y-1 hover:shadow-none">Leave a whisper <span class="ml-3 text-2xl">↗</span></a>
        <% } else { %>
          <a href="/sign-up" class="mt-8 inline-flex rounded-full bg-ink px-6 py-3 font-bold text-white shadow-[5px_5px_0_#ff6b5f] transition hover:translate-x-1 hover:translate-y-1 hover:shadow-none">Join the conversation <span class="ml-2">↗</span></a>
        <% } %>
      </div>
      <div class="relative flex min-h-64 items-start justify-center">
        <img src="/images/whisperwell-owl.png" alt="A friendly owl whispering a secret" class="h-96 w-96 max-w-full object-contain transition duration-500 hover:-rotate-3 hover:scale-105">
      </div>
    </section>

    <section class="mt-20">
      <div class="mb-8 flex items-end justify-between gap-4 border-b-2 border-ink/10 pb-5">
        <div><p class="text-xs font-black uppercase tracking-[0.2em] text-coral">The latest whispers</p><h2 class="mt-2 font-display text-4xl">From the well</h2></div>
        <span class="rounded-full bg-lilac px-3 py-1 text-sm font-bold"><%= messages.length %> <%= messages.length === 1 ? 'note' : 'notes' %></span>
      </div>

      <% if (messages.length === 0) { %>
        <div class="rounded-3xl border-2 border-dashed border-ink/20 bg-white p-12 text-center"><p class="font-display text-2xl">The well is waiting for its first whisper.</p></div>
      <% } else { %>
        <div class="grid gap-6 md:grid-cols-2">
          <% messages.forEach((message, index) => { %>
            <article class="group relative rounded-3xl border-2 <%= index % 2 === 0 ? 'border-coral/30 shadow-[7px_7px_0_#e6ddff]' : 'border-ink/15 shadow-[7px_7px_0_#c9f5df]' %> bg-white p-7 transition duration-300 ease-out hover:-translate-y-2 hover:rotate-[1deg] hover:shadow-[12px_14px_0_<%= index % 2 === 0 ? '#e6ddff' : '#c9f5df' %>]">
              <span class="absolute -right-2 -top-3 grid h-9 w-9 rotate-12 place-items-center rounded-full border-2 border-ink bg-<%= index % 2 === 0 ? 'coral' : 'mint' %> text-sm shadow-[2px_2px_0_#20243a] transition duration-300 group-hover:rotate-45">✦</span>
              <img src="/images/whisperwell-owl-smile.png" alt="" aria-hidden="true" class="pointer-events-none absolute -bottom-3 right-5 z-10 h-16 w-16 translate-y-5 scale-75 opacity-0 transition duration-300 ease-out group-hover:-translate-y-1 group-hover:scale-100 group-hover:opacity-100">
              <div class="mb-6 flex items-center justify-between gap-4"><span class="rounded-full bg-ink px-3 py-1 text-xs font-bold uppercase tracking-wider text-white transition group-hover:bg-coral">Note <%= index + 1 %></span><% if (isMember) { %><time class="text-xs font-bold text-ink/45" datetime="<%= message.created_at.toISOString() %>"><%= new Date(message.created_at).toLocaleDateString() %></time><% } %></div>
              <h3 class="font-display text-3xl"><%= message.title %></h3>
              <p class="mt-4 leading-7 text-ink/70"><%= message.story %></p>
              <div class="mt-7 flex items-center justify-between border-t border-ink/10 pt-4 text-sm font-bold">
                <% if (isMember) { %><span class="text-coral">— <%= message.first_name %> <%= message.last_name %></span><% } else { %><span class="text-ink/40">— identity tucked away</span><% } %>
                <% if (isMember) { %><span class="text-ink/40"><%= new Date(message.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span><% } %>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
